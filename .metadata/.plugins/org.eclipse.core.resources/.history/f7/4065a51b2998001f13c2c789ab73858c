#include "fsm_automatic.h"

void fsm_automatic_run(){
	switch (status[ODD]){
	case INIT:
		status[ODD] = AUTO_RED;
		countGreen = timerGreen/100;
		countRed = 0;
		countYellow = 0;
		setTimer(ODD, timerRed);
		setTimer(3, 100);
		break;
	case AUTO_RED:

		if(timer_flag[3] == 1){
			if(countGreen > 0) countGreen--;
			if(countYellow > 0) countYellow--;
			setTimer(3, 100);
		}

		if(countGreen == 0 && countYellow == 0) countYellow = timerYellow/100;
			onRed1();
			if(countGreen > 0) onGreen2();
			else onYellow2();

		if(timer_flag[ODD] == 1){
			status[ODD] = AUTO_GREEN;
			setTimer(ODD, timerGreen);
			countRed = timerRed/100;
			countGreen = 0;
			countYellow = 0;
			setTimer(3, 100);
		}
		break;
	case AUTO_GREEN:
		if(timer_flag[3] == 1){
			countRed--;
			setTimer(3, 100);
		}

			onGreen1();
			onRed2();

		if(timer_flag[ODD] == 1){
			status[ODD] = AUTO_YELLOW;
			setTimer(ODD, timerYellow);
			setTimer(3, 100);
		}
		break;
	case AUTO_YELLOW:
		if(timer_flag[3] == 1){
			countRed--;
			setTimer(3, 100);
		}

			onYellow1();
			onRed2();

		if(timer_flag[ODD] == 1){
			status[ODD] = INIT;
		}
		break;
	default:
		break;
	}

}



void fsm_automatic_run2(){
	switch (status[EVEN]){
		case INIT:
			status[EVEN] = AUTO_GREEN;
			setTimer(EVEN, timerGreen);
			countGreen2 = timerGreen/100;
			countRed2 = 0;
			countYellow2 = 0;
			setTimer(3, 100);
			break;
		case AUTO_RED:
			onRed2();
			if(timer_flag[3] == 1){
				countRed2--;
				setTimer(3, 100);
			}
			if(countRed2 > timerYellow/100) onGreen1();
			else onYellow1();
			if(timer_flag[EVEN] == 1){
				status[EVEN] = INIT;
			}
			break;
		case AUTO_GREEN:
			onGreen2();
			onRed1();
			if(timer_flag[3] == 1){
				countGreen2--;
				setTimer(3, 100);
			}

			if(timer_flag[EVEN] == 1){
				status[EVEN] = AUTO_YELLOW;
				setTimer(EVEN, timerYellow);
				setTimer(3, 100);
				countYellow2 = timerYellow/100;
			}
			break;
		case AUTO_YELLOW:
			onYellow2();
			onRed1();
			if(timer_flag[3] == 1){
				countYellow2--;
				setTimer(3, 100);
			}

			if(timer_flag[EVEN] == 1){
				status[EVEN] = AUTO_RED;
				setTimer(EVEN, timerRed);
				countRed2 = timerRed/100;
				setTimer(3, 100);
			}
			break;
		default:
			break;
	}
}
