#include "fsm_automatic.h"

void fsm_automatic_run(int i){
	switch (status[i]){
	case INIT:
		status[i] = AUTO_RED;
		countRed = 0;
		setTimer(i, timerRed);
		setTimer(3, 100);
		break;
	case AUTO_RED:
		if(timer_flag[3] == 1){
			countRed++;
			setTimer(3, 100);
		}
		if(i == ODD){
			onRed1();
			if(countRed < timerGreen/100) onGreen2();
			else onYellow2();
		}
		else{
			onRed2();
			if(countRed < timerGreen/100) onGreen1();
			else onYellow1();
		}

		if(timer_flag[i] == 1){
			status[i] = AUTO_GREEN;
			setTimer(i, timerGreen);
			countRed = 0;
			setTimer(3, 100);
		}
		break;
	case AUTO_GREEN:
		if(timer_flag[3] == 1){
			countRed++;
			setTimer(3, 100);
		}
		if(i == ODD){
			onGreen1();
			onRed2();
		}
		else{
			onGreen2();
			onRed1();
		}
		if(timer_flag[i] == 1){
			status[i] = AUTO_YELLOW;
			setTimer(i, timerYellow);
			countRed = 0;
			setTimer(3, 100);
		}
		break;
	case AUTO_YELLOW:
		if(timer_flag[3] == 1){
			countRed++;
			setTimer(3, 100);
		}
		if(i == ODD){
			onYellow1();
			onRed2();
		}
		else{
			onYellow2();
			onRed1();
		}
		if(timer_flag[i] == 1){
			status[i] = INIT;
		}
		break;
	default:
		break;
	}

}
