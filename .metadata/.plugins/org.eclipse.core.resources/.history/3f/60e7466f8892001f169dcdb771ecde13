#include "traffic_light_manual.h"


void traffic_light_manual_run(){
	if(isButtonPressed(1) == 1 && status_traffic != MODE_2){
		status_traffic = MODE_2;
		reset_light();
		setTimer(4,50);
	}
	switch (status_traffic){
		case MODE_2:

			if(timer_flag[4] == 1){
				red_blinky();
				setTimer(4,50);
			}
			if(isButtonPressed(1) == 1){
				status_traffic = MODE_3;
				reset_light();
				setTimer(4,50);
			}
			if(isButtonPressed(2) == 1){
				timerRed += 100;
			}
			if(isButtonPressed(3) == 1){
				status_traffic = ODD;
				reset_light();
				//status = INIT;
			}
			break;
		case MODE_3:
			if(timer_flag[4] == 1){
				green_blinky();
				setTimer(4,50);
			}
			if(isButtonPressed(1) == 1){
				status_traffic = MODE_4;
				reset_light();
				setTimer(4,50);
			}
			if(isButtonPressed(2) == 1){
				timerGreen += 100;
			}
			if(isButtonPressed(3) == 1){
				status_traffic = ODD;
				reset_light();
			}
			break;
		case MODE_4:
			if(timer_flag[4] == 1){
				yellow_blinky();
				setTimer(4,50);
			}
			if(isButtonPressed(1) == 1){
				status_traffic = INIT_traffic;
				reset_light();
			}
			if(isButtonPressed(2) == 1){
				timerYellow += 100;
			}
			if(isButtonPressed(3) == 1){
				status_traffic = INIT_traffic;
				reset_light();
			}
			break;
		default:
			break;
	}
}
